---
// The home page opening. The sentence describes three things the products do; each of
// those phrases is "locked onto" by a viewfinder and links to the product that does it.
import { href, type Lang } from '../i18n';
import { intro } from '../data/profile';
import { getProject } from '../data/projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { hello, statement, after } = intro[lang];

let framed = 0;
const parts = statement.map((part) => {
  if (typeof part === 'string') return { text: part };
  const project = getProject(part.project);
  if (!project) throw new Error(`intro: unknown project "${part.project}"`);
  return { text: part.text, tag: project.name[lang], link: href('work/' + project.slug, lang), index: framed++ };
});
---
<section class="intro wrap">
  <h1 class="intro__hello">{hello}</h1>
  <p class="intro__statement">
    {parts.map((p) =>
      p.link ? (
        <a class="scan frame" href={p.link} style={`--i:${p.index}`}>{p.text}<span class="scan__tag">{p.tag}</span></a>
      ) : (
        p.text
      ),
    )}
  </p>
  <p class="intro__after">{after}</p>
</section>

<style>
  .intro { padding-block: clamp(40px, 9vw, 104px) clamp(8px, 2vw, 24px); }
  .intro__hello { font-size: clamp(30px, 5.4vw, 52px); }

  /* Generous leading: the tag under each framed phrase sits in the gap between lines. */
  .intro__statement {
    margin-top: clamp(14px, 2.4vw, 26px);
    max-width: 24em;
    font-family: var(--font-display);
    font-size: clamp(23px, 3.7vw, 38px);
    line-height: 2.1;
  }
  .intro__after { margin-top: clamp(14px, 2vw, 20px); max-width: 32em; font-size: clamp(17px, 2vw, 20px); color: var(--ink-2); }

  .scan {
    --frame-inset: 0.34em -0.04em;
    --frame-arm: 0.28em;
    display: inline-block;
    margin-inline: 0.22em;
    padding-inline: 0.16em;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .scan::before { animation: lock 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: calc(var(--i) * 0.22s + 0.35s); }
  .scan__tag {
    position: absolute; left: 0; bottom: -0.15em;
    font: 500 12px/1 var(--font-mono); letter-spacing: 0.03em; color: var(--ink-3);
    animation: tag 0.3s ease-out both; animation-delay: calc(var(--i) * 0.22s + 0.75s);
  }
  .scan__tag::before { content: '→ '; }
  .scan:hover, .scan:focus-visible { background: var(--bill-wash); }
  .scan:hover .scan__tag, .scan:focus-visible .scan__tag { color: var(--tide); }

  /* The brackets start wide and soft, then close in on the phrase — a focus lock. */
  @keyframes lock {
    from { opacity: 0; transform: scale(1.5, 1.9); }
    to { opacity: 1; transform: none; }
  }
  @keyframes tag {
    from { opacity: 0; transform: translateY(-3px); }
    to { opacity: 1; transform: none; }
  }
</style>
