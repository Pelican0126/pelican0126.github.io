---
import { href, type Lang } from '../i18n';
import { t } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<footer class="footer">
  <div class="wrap footer__inner mono">
    <span>© {new Date().getFullYear()} {site.handle}</span>
    <span class="footer__links">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.github} rel="noopener">GitHub</a>
      <a href={href('rss.xml', lang)}>{t('footer.rss', lang)}</a>
      <a href={site.source} rel="noopener">{t('footer.source', lang)}</a>
    </span>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); }
  .footer__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-block: 24px; }
  .footer__links { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .footer a { color: var(--ink-2); text-decoration: none; }
  .footer a:hover { color: var(--ink); text-decoration: underline; }
</style>
