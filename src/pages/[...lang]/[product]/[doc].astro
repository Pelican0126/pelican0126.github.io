---
// A product's privacy / support page at /<slug>/<doc>/, from src/content/legal/<lang>/<slug>/<doc>.md.
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { href, langParam, otherLang, type Lang } from '../../../i18n';
import { t } from '../../../i18n/ui';
import { getProject } from '../../../data/projects';
import { getDocs, type Doc } from '../../../lib/legal';
import { projectLink } from '../../../lib/projects';

export async function getStaticPaths() {
  const docs = await getDocs();
  return docs.map((doc) => {
    const project = getProject(doc.project);
    if (!project?.intro) throw new Error(`legal ${doc.id}: "${doc.project}" is not a product with a generated home page`);
    const translated = docs.some((d) => d.project === doc.project && d.doc === doc.doc && d.lang === otherLang(doc.lang));
    return {
      params: { lang: langParam(doc.lang), product: doc.project, doc: doc.doc },
      props: { lang: doc.lang, entry: doc, translated },
    };
  });
}

interface Props {
  lang: Lang;
  entry: Doc;
  translated: boolean; // the same page exists in the other language
}
const { lang, entry, translated } = Astro.props;
const path = `${entry.project}/${entry.doc}`;
const project = getProject(entry.project)!;
const { Content } = await render(entry);
---
<Base lang={lang} path={path} altPath={translated ? path : entry.project} section="work" title={entry.data.title} description={entry.data.description}>
  <article class="wrap page">
    <Breadcrumbs
      label={t('crumbs.label', lang)}
      items={[
        { label: t('work.title', lang), href: href('work', lang) },
        { label: project.name[lang], href: projectLink(project, lang)!.href },
        { label: entry.data.label },
      ]}
    />
    <h1 class="page__title">{entry.data.title}</h1>
    <p class="mono legal__subtitle">{entry.data.subtitle}</p>
    <div class="prose legal__body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .legal__subtitle { margin-top: 10px; max-width: 60em; }
  .legal__body { margin-top: 28px; }
</style>
