---
import Base from '../../../layouts/Base.astro';
import Status from '../../../components/Status.astro';
import { LANGS, asset, href, langParam, type Lang } from '../../../i18n';
import { t } from '../../../i18n/ui';
import { products, type Project } from '../../../data/projects';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    products.map((project) => ({
      params: { lang: langParam(lang), slug: project.slug },
      props: { lang, project },
    })),
  );
}

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project } = Astro.props;
const { demo } = project;
const intro = project.intro!;
const isPublic = project.visibility === 'public';
const title = [project.name[lang], project.label?.[lang]].filter(Boolean).join(' · ');
const links = (project.links ?? []).map((l) => ({
  label: l.label[lang],
  href: l.path ? href(l.path, lang) : l.href,
}));
---
<Base lang={lang} path={'work/' + project.slug} title={title} description={project.tagline[lang]}>
  <article class:list={['wrap page work', demo?.portrait && 'work--side']}>
    <header class="work__head">
      <a class="back" href={href('work', lang)}>{t('work.back', lang)}</a>
      <p class="work__state">
        <Status status={project.status} lang={lang} />
        <span class="mono">{isPublic ? t('work.openSource', lang) : t('work.private', lang)}</span>
      </p>
      <h1 class="page__title">
        {project.name[lang]}
        {project.label && <span class="work__label">{project.label[lang]}</span>}
      </h1>
      <p class="page__lead">{project.tagline[lang]}</p>
      {(project.repo || links.length > 0) && (
        <p class="work__actions">
          {isPublic && project.repo && <a class="btn btn--solid" href={project.repo} rel="noopener">{t('work.repo', lang)}</a>}
          {links.map((l) => <a class="btn" href={l.href} rel="noopener">{l.label}</a>)}
        </p>
      )}
    </header>

    {demo && (
      <div class="work__media frame">
        {demo.type === 'video' ? (
          <video src={asset(demo.src)} poster={demo.poster && asset(demo.poster)} controls playsinline preload="none"></video>
        ) : (
          <img src={asset(demo.src)} alt={project.name[lang]} loading="lazy" />
        )}
      </div>
    )}

    <div class="work__body">
      <p class="work__summary">{intro.summary[lang]}</p>

      <h2>{t('work.highlights', lang)}</h2>
      <ul class="work__features">
        {intro.features.map((f) => <li>{f[lang]}</li>)}
      </ul>

      <h2>{t('work.stack', lang)}</h2>
      <ul class="chips">
        {project.stack.map((s) => <li>{s}</li>)}
      </ul>

      {intro.note && <p class="work__note">{intro.note[lang]}</p>}
      <p class="mono work__meta">{isPublic ? t('work.repoNote', lang) : t('work.privateNote', lang)}</p>

      <div class="work__cta">
        <p>{t('work.ctaLead', lang)}</p>
        <a class="btn" href={href('about', lang) + '#contact'}>{t('work.cta', lang)}</a>
      </div>
    </div>
  </article>
</Base>

<style>
  .work { display: grid; gap: clamp(28px, 5vw, 48px); }
  .work__state { display: flex; align-items: center; gap: 16px; margin-bottom: 14px; }
  .work__label { margin-left: 0.4em; font-size: 0.55em; color: var(--ink-2); white-space: nowrap; }
  .work__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }

  /* The demo sits inside the viewfinder. */
  .work__media { --frame-inset: -9px; --frame-arm: 18px; margin: 9px; }
  .work__media video, .work__media img { width: 100%; height: auto; border-radius: var(--radius); background: var(--surface); }

  .work__body { max-width: 40em; }
  .work__summary { font-size: 18px; }
  .work__body h2 { margin-top: 36px; margin-bottom: 12px; font-size: 20px; }
  .work__features { padding-left: 1.2em; }
  .work__features li + li { margin-top: 6px; }
  .work__features li::marker { color: var(--bill); }
  .work__note { margin-top: 32px; padding-left: 16px; border-left: 2px solid var(--bill); }
  .work__meta { margin-top: 20px; }
  .work__cta { margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--line); }
  .work__cta p { margin-bottom: 14px; color: var(--ink-2); }

  /* Portrait demos (phone recordings, extension popups) stand beside the text. */
  .work--side .work__media { max-width: 340px; }
  @media (min-width: 900px) {
    .work--side { grid-template-columns: minmax(0, 1fr) 340px; column-gap: 64px; align-items: start; }
    .work--side .work__head, .work--side .work__body { grid-column: 1; }
    .work--side .work__media { grid-column: 2; grid-row: 1 / span 2; position: sticky; top: 24px; }
  }
</style>
