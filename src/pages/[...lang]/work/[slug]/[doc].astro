---
// Privacy / support pages from src/content/legal/<lang>/<project>/<doc>.md,
// served at /work/<project>/<doc>/ (the URLs the app stores point at).
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { href, langParam, type Lang } from '../../../../i18n';
import { getProject } from '../../../../data/projects';

export async function getStaticPaths() {
  const entries = await getCollection('legal');
  return entries.map((entry) => {
    const [lang, slug, doc] = entry.id.split('/') as [Lang, string, string];
    return { params: { lang: langParam(lang), slug, doc }, props: { lang, slug, doc, entry } };
  });
}

interface Props {
  lang: Lang;
  slug: string;
  doc: string;
  entry: CollectionEntry<'legal'>;
}
const { lang, slug, doc, entry } = Astro.props;
const project = getProject(slug);
if (!project) throw new Error(`legal: unknown project "${slug}" (${entry.id})`);
const { Content } = await render(entry);
---
<Base lang={lang} path={`work/${slug}/${doc}`} title={entry.data.title} description={entry.data.description}>
  <article class="wrap page">
    <a class="back" href={href('work/' + slug, lang)}>← {project.name[lang]}</a>
    <h1 class="page__title">{entry.data.title}</h1>
    <p class="mono legal__subtitle">{entry.data.subtitle}</p>
    <div class="prose legal__body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .legal__subtitle { margin-top: 10px; }
  .legal__body { margin-top: 28px; }
</style>
