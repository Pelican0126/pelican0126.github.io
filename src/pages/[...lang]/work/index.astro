---
import Base from '../../../layouts/Base.astro';
import ProjectList from '../../../components/ProjectList.astro';
import { langPaths, type Lang } from '../../../i18n';
import { t } from '../../../i18n/ui';
import { clientWork, moreProjects, products } from '../../../data/projects';

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<Base lang={lang} path="work" section="work" title={t('work.title', lang)} description={t('work.lead', lang)}>
  <div class="wrap page">
    <h1 class="page__title">{t('work.title', lang)}</h1>
    <p class="page__lead">{t('work.lead', lang)}</p>

    <section class="section">
      <h2 class="section__title section__head">{t('work.products', lang)}</h2>
      <ProjectList projects={products} lang={lang} />
    </section>

    {clientWork.length > 0 && (
      <section class="section">
        <h2 class="section__title section__head">{t('work.client', lang)}</h2>
        <ProjectList projects={clientWork} lang={lang} />
      </section>
    )}

    <section class="section">
      <h2 class="section__title section__head">{t('work.more', lang)}</h2>
      <ProjectList projects={moreProjects} lang={lang} />
    </section>
  </div>
</Base>
